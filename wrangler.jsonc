// Cloudflare Worker config (specs/001-realtime-room-board/plan.md). Rate limit bindings are added by the tasks that use them.
// D1 has no database_id: wrangler provisions it on first deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roomboard",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/rooms/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "roomboard", "migrations_dir": "migrations" }],
  // SQLite-backed class (free plan); v1 keeps state in memory and socket attachments only (plan.md Storage).
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "RoomDurableObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] }],
  // research R9, per client IP: room creation 3, password tries 5, reports 10, failed admin tokens 5, each per 60 s.
  // RL_BUG_REPORT: automatic error reports 10 per 60 s (002 research R4).
  "ratelimits": [
    { "name": "RL_CREATE", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "RL_PASSWORD", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_REPORT", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_ADMIN", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_BUG_REPORT", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } }
  ],
  // 002 T036: GitHub issue sync every 5 minutes (github-sync.ts).
  "triggers": { "crons": ["*/5 * * * *"] },
  // Declared so `wrangler types` knows them without a .dev.vars (CI); values come from .dev.vars locally, `wrangler secret` when deployed.
  "secrets": { "required": ["TURNSTILE_SECRET", "SERVER_SECRET", "ADMIN_TOKEN", "GITHUB_ISSUES_TOKEN"] }
}
