// Cloudflare Worker config (specs/001-realtime-room-board/plan.md). Rate limit bindings are added by the tasks that use them.
// D1 has no database_id: wrangler provisions it on first deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roomboard",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/rooms/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "roomboard", "migrations_dir": "migrations" }],
  // SQLite-backed class (free plan); v1 keeps state in memory and socket attachments only (plan.md Storage).
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "RoomDurableObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] }]
}
