// Cloudflare Worker config (specs/001-realtime-room-board/plan.md). Durable Object and rate limit bindings are added by
// the tasks that use them. D1 has no database_id: wrangler provisions it on first deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roomboard",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "roomboard", "migrations_dir": "migrations" }]
}
